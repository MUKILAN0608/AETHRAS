# AETHRAS Environment Variables
# Copy to .env and fill in values. Never commit .env to git.

# PostgreSQL — game state persistence
POSTGRES_USER=aethras
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=aethras
POSTGRES_PORT=5432

# Redis — temporary match state and caching
REDIS_PASSWORD=change_me_redis_password
REDIS_PORT=6379

# Go Game Server
GAME_SERVER_NAME=aethras-game-server
GAME_SERVER_PORT=8080
AI_SERVICE_URL=http://localhost:8000

# Python AI Service
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000

# Godot client (reference only)
GODOT_GAME_SERVER_URL=http://localhost:8080
