# AETHRAS Environment Variables
# Copy to .env and fill in values. Never commit .env to git.

# PostgreSQL — game state persistence
POSTGRES_USER=aethras
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=aethras
POSTGRES_PORT=5432

# Redis — temporary match state and caching
REDIS_PASSWORD=change_me_redis_password
REDIS_PORT=6379

# Go Game Server
GAME_SERVER_NAME=aethras-game-server
GAME_SERVER_PORT=8080
AI_SERVICE_URL=http://localhost:8000

# Python AI Service
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000

# Godot client (reference only)
GODOT_GAME_SERVER_URL=http://localhost:8080

# AETHRAS decision integration (server-side only)
AETHRAS_DECISION_ENABLED=false
AETHRAS_DECISION_PROVIDER=cloudflare_clef_flash
AETHRAS_DECISION_TIMEOUT_SECONDS=3
AETHRAS_DECISION_MAX_RETRIES=0

# Cloudflare Workers AI: never copy credentials into Godot
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AUTH_TOKEN=
CLOUDFLARE_CLEF_MODEL=@cf/cloudflare/clef-flash
CLOUDFLARE_CLEF_API_BASE_URL=https://api.cloudflare.com/client/v4

# Initial uncalibrated review policies
DECISION_MIN_CONFIDENCE=0.7
DECISION_SELECTION_MIN_MARGIN=0.1
DECISION_REVIEW_THRESHOLD=0.5
DECISION_SIMULATION_THRESHOLD=0.5
# Explicit opt-in to a billable live smoke test
AETHRAS_DECISION_LIVE_TEST=false
